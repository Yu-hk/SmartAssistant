# =============================================================================
# SmartAssistant - 生产环境变量模板
# 复制为 .env 并填入真实值，放置于 deploy/ 目录下
# 使用：docker compose --env-file .env up -d
#
# ⚠️ 安全须知：
#   1. 本文件仅为占位符模板，禁止在此填入任何真实密钥。
#   2. 真实密钥请写入 deploy/.env（已被 .gitignore 忽略，不会入库）。
#   3. 所有 CHANGE_ME_* 均须替换为强随机值后方可用于生产。
# =============================================================================

# --- DeepSeek API ---
DEEPSEEK_API_KEY=<REDACTED>

# --- PostgreSQL ---
POSTGRES_DB=a2a_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- RabbitMQ（工作流自动恢复） ---
RABBITMQ_USERNAME=smartassistant
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
ROUTER_GRAPH_RECOVERY_ENABLED=true

# --- 项目原生 Agentic RAG（无需外部知识库服务或应用 Key） ---
PRODUCT_RAG_AGENTIC_ENABLED=true
PRODUCT_RAG_AGENTIC_MAX_ATTEMPTS=2
PRODUCT_RAG_AGENTIC_MAX_EVIDENCE_ITEMS=8
PRODUCT_RAG_AGENTIC_SUFFICIENT_SCORE=0.5
PRODUCT_RAG_ANSWER_VERIFICATION_MAX_RETRIES=1

# --- Nacos ---
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME_nacos_password
# NACOS_AUTH_TOKEN 必须为 Base64 编码且至少 32 字节；可用：openssl rand -base64 48
NACOS_AUTH_TOKEN=<REDACTED>

# --- JWT（至少 256 bit；可用：openssl rand -base64 48）---
JWT_SECRET=CHANGE_ME_jwt_secret_min_256_bit

# --- 第三方登录（只启用已配置凭据和回调白名单的渠道）---
OAUTH_PUBLIC_BASE_URL=https://xiaoyuai.cloud
OAUTH_FRONTEND_BASE_URL=https://xiaoyuai.cloud
OAUTH_WECHAT_ENABLED=false
OAUTH_WECHAT_CLIENT_ID=
OAUTH_WECHAT_CLIENT_SECRET=
OAUTH_DINGTALK_ENABLED=false
OAUTH_DINGTALK_CLIENT_ID=
OAUTH_DINGTALK_CLIENT_SECRET=
OAUTH_FEISHU_ENABLED=false
OAUTH_FEISHU_CLIENT_ID=
OAUTH_FEISHU_CLIENT_SECRET=

# --- Grafana（监控面板管理员）---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# --- MinIO（Milvus 对象存储）---
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
