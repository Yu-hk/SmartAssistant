# SmartAssistant 环境变量配置模板
# 复制此文件为 .env，填入真实值后使用
# ⚠️ 注意：.env 文件已加入 .gitignore，不会提交到版本控制

# =======================================
# 深度求索 DeepSeek API
# =======================================
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=<REDACTED>

# =======================================
# 阿里云 DashScope API
# =======================================
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here
MODEL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRODUCT_CHAT_MODEL=qwen3.7-flash
PRODUCT_ANALYSIS_MODEL=qwen3.7-flash
PRODUCT_STANDARD_MODEL=qwen3.7-flash
PRODUCT_RECOMMENDATION_MODEL=qwen3.7-plus

# 项目原生 Agentic RAG（无需外部知识库服务或应用 Key）
PRODUCT_RAG_AGENTIC_ENABLED=true
PRODUCT_RAG_AGENTIC_MAX_ATTEMPTS=2
PRODUCT_RAG_AGENTIC_MAX_EVIDENCE_ITEMS=8
PRODUCT_RAG_AGENTIC_SUFFICIENT_SCORE=0.5
PRODUCT_RAG_ANSWER_VERIFICATION_MAX_RETRIES=1

# =======================================
# 高德地图 API
# =======================================
# 申请地址：https://lbs.amap.com/
AMAP_API_KEY=your-amap-api-key-here

# =======================================
# PostgreSQL 数据库（⚠️ 必须设置）
# =======================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=a2a_system
POSTGRES_USER=postgres
# ⚠️ 必须设置，所有服务启动时将强制校验
POSTGRES_PASSWORD=your-postgres-password-here

# =======================================
# Redis
# =======================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password-here  # 如果 Redis 设置了密码

# ============================================
# RabbitMQ（工作流自动恢复）
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartassistant
RABBITMQ_PASSWORD=your-rabbitmq-password-here

# =======================================
# JWT 配置（⚠️ 必须设置）
# =======================================
# 建议使用 256 位随机字符串，生成命令：openssl rand -base64 32
# ⚠️ 必须设置此值，所有服务启动时将强制校验，未设置会报错
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long

# =======================================
# 生产域名 / CORS
# =======================================
# 多个来源使用英文逗号分隔；本地开发可按需追加 localhost。
CORS_ALLOWED_ORIGINS=https://xiaoyuai.cloud,https://www.xiaoyuai.cloud

# =======================================
# Nacos 服务注册
# =======================================
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME

# =======================================
# HanLP 数据路径（可选）
# =======================================
# 如不配置，HanLP 会自动从 classpath:/data 或用户目录 ~/.hanlp 查找
# HANLP_DATA_PATH=D:/workspace/SmartAssistant/hanlp-data

# =======================================
# 监控配置（可选）
# =======================================
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
GRAFANA_ADMIN_PASSWORD=admin
