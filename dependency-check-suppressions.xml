<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        GHSA-qwww-vcr4-c8h2: React Router RSC Mode CSRF Bypass
        影响范围: react-router >=7.12.0 <8.3.0，仅当应用使用 unstable RSC API 时可利用。
        抑制依据:
          1. 本项目前端 (frontend/src/main.tsx) 使用 <BrowserRouter> 声明式模式 (Declarative Mode)，
             全仓无 Framework Mode / unstable RSC API 用法，攻击路径不存在。
          2. 官方修复版本为 8.3.0 (v8)，其 peerDependencies 要求 React >= 19.2.7，
             本项目为 React ^18.2.0，升级需 React 19 大版本迁移，暂不实施。
        复审条件: 前端升级 React 19 或引入 react-router Framework/RSC 模式时，移除本抑制并升级至 >= 8.3.0。
        添加日期: 2026-07-27
    -->
    <suppress>
        <notes><![CDATA[react-router RSC CSRF - 项目使用 Declarative Mode，不受影响；修复版 v8 需 React 19]]></notes>
        <packageUrl regex="true">^pkg:npm/react\-router(\-dom)?@7\..*$</packageUrl>
        <vulnerabilityName>GHSA-qwww-vcr4-c8h2</vulnerabilityName>
    </suppress>
</suppressions>
