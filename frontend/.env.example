# 智能客服 Agent 环境变量配置
# 复制此文件为 .env 并填入你的配置

# CodeBuddy API Key（必填）
# 从 https://www.codebuddy.cn 获取
CODEBUDDY_API_KEY=your_api_key_here

# 服务器端口（可选，默认 3001）
PORT=3001
# 可选：登录页外部入口。未配置时页面会给出明确提示，不会出现无响应按钮。
VITE_PASSWORD_RESET_URL=
VITE_SSO_WECOM_URL=
VITE_SSO_DINGTALK_URL=
VITE_SSO_FEISHU_URL=
VITE_SUPPORT_EMAIL=support@example.com
