# 智能客服 Agent 环境变量配置
# 复制此文件为 .env 并填入你的配置

# CodeBuddy API Key（必填）
# 从 https://www.codebuddy.cn 获取
CODEBUDDY_API_KEY=your_api_key_here

# 服务器端口（可选，默认 3001）
PORT=3001
# 可选：企业身份登录入口。必须指向已完成 OAuth state 校验、回调换票和
# SmartAssistant JWT 签发的服务端 SSO 网关；只填写平台授权页 URL 无法建立本站登录态。
# 未配置时登录页会禁用对应渠道并明确显示“未开通”。
VITE_PASSWORD_RESET_URL=
VITE_SSO_WECOM_URL=
VITE_SSO_DINGTALK_URL=
VITE_SSO_FEISHU_URL=
VITE_SUPPORT_EMAIL=support@example.com
