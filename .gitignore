# ========================================
# Git Ignore Configuration
# ========================================

# IDE
.idea/
.vscode/
.vs/
.codebuddy/
*.iml
*.ipr
*.iws

# Build output
target/
build/
dist/
*.jar
*.war
*.class
*.tsbuildinfo

# Logs
logs/
*.log
*.log.*
*.gz

# Environment variables (IMPORTANT!)
# 真实密钥文件一律忽略；仅 deploy/.env.production 作为占位符模板允许入库
.env
.env.local
.env.*.local
deploy/.env
!deploy/.env.production

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Node modules (root level)
node_modules/

# GitHub API temp files
.gh_api_tmp.*

# Maven custom config
.m2_*.conf

# Downloaded/extracted artifacts (not project source)
.mvn_extracted/
ai/onnxruntime/native/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Monitoring data
monitoring/data/
monitoring/logs/
monitoring/*.db

# Test coverage
coverage/
.nyc_output/

# HanLP data (large binary files)
hanlp-data/*.jar

# Misplaced class files at root
BOOT-INF/
EmbeddingDebugTool.class

# Build logs
build.log
consumer-build.log

# Post result test files
post_result*.json

# WorkBuddy session data (do not commit)
.workbuddy/
.codex-output/

# Lingma local config
.lingma/
cp.txt

# Duplicate root-level eval output; the maintained baseline lives under
# smart-assistant-common/src/test/resources/.
/src/test/resources/eval-baseline.json

# BGE ONNX model files (large binary, ~95MB-1.2GB)
models/*.onnx

# bge-reranker ONNX model (large binary, ~1.1GB)
models/bge-reranker-v2-m3.onnx
models/bge-reranker-v2-m3/

# ONNX external weight data files (very large, 2.2GB+)
models/*.onnx.data
**/models/*.onnx.data

# Test model output
**/models/*.onnx
**/models/onnx/

# BGE cloned model repos (git LFS, not part of the project source)
**/models/bge-large-zh-v1.5/
**/models/bge-small-zh-v1.5/

# BGE model cache (downloaded at runtime, large binary files)
models/cache/

# User runtime data (conversation memories/corrections, auto-generated at runtime)
data/users/
data/corrections/
smart-assistant-consumer/data/

# Frontend TypeScript build metadata and generated JavaScript/declarations
frontend/server/*.js
frontend/server/*.d.ts
frontend/src/main.js
frontend/vite.config.js
frontend/vite.config.d.ts

login_tmp.json
nul
smart-assitant-router/

# One-off local maintenance and preview artifacts
.cleanup_unused_imports.py
.tool_registry_section.md
login-preview.html
redesign-preview.html
e2e-test.json
tool-call-record.json
tool-deprecate.json
