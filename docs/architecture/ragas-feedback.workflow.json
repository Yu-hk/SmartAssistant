{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {"title": "SmartAssistant 四维评测与检索反馈", "locale": "zh-CN", "quality_profile": "showcase"},
  "lanes": [{"id": "capture", "label": "合成只读样本"}, {"id": "judge", "label": "离线质量评估"}, {"id": "review", "label": "反馈与人工复核"}],
  "mainPath": ["questions", "live", "contract", "metrics", "stability", "diagnosis"],
  "nodes": [
    {"id": "questions", "lane": "capture", "col": 0, "type": "frontend", "label": "冻结问题与金标", "sublabel": "独立参考答案"},
    {"id": "live", "lane": "capture", "col": 1, "type": "backend", "label": "商品只读证据采集", "width": 140, "sublabel": "字段覆盖与来源追踪"},
    {"id": "contract", "lane": "capture", "col": 2, "type": "security", "label": "证据完整性检查", "sublabel": "缺失与未知分别标记"},
    {"id": "metrics", "lane": "judge", "col": 2, "type": "backend", "label": "Ragas 四维评测", "sublabel": "固定输入重复评分"},
    {"id": "stability", "lane": "judge", "col": 3, "type": "database", "label": "保留各轮原始分数", "width": 140, "sublabel": "中位数与波动范围"},
    {"id": "diagnosis", "lane": "review", "col": 3, "type": "backend", "label": "证据影子诊断", "sublabel": "原分数复放与分类"},
    {"id": "manual", "lane": "review", "col": 4, "type": "security", "label": "开发集选择策略", "sublabel": "实体约束与证据保留"},
    {"id": "holdout", "lane": "review", "col": 5, "type": "security", "label": "冻结留出集验证", "sublabel": "不自动更新生产权重"}
  ],
  "edges": [
    {"from": "questions", "to": "live", "label": "固定只读问题"},
    {"from": "live", "to": "contract", "label": "有序证据"},
    {"from": "contract", "to": "metrics", "label": "有效样本"},
    {"from": "metrics", "to": "stability", "label": "四项分数"},
    {"from": "stability", "to": "diagnosis", "label": "重复观测"},
    {"from": "diagnosis", "to": "manual", "label": "影子建议", "variant": "dashed"},
    {"from": "manual", "to": "holdout", "label": "固定候选策略"}
  ],
  "cards": [
    {"dot": "cyan", "title": "四项指标", "items": ["上下文召回率、上下文精度", "忠实度、答案相关性"]},
    {"dot": "amber", "title": "证据与波动", "items": ["保留原问题与子问题证据席位", "未知与合计不凭低分补造证据"]},
    {"dot": "rose", "title": "执行边界", "items": ["不读取真实用户会话，不执行订单", "建议不自动修改线上检索权重"]}
  ]
}
