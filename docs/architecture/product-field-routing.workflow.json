{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "商品固定字段检索流程",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "request", "label": "问题与选域" },
    { "id": "catalog", "label": "目录字段与召回" },
    { "id": "result", "label": "实时事实" }
  ],
  "mainPath": ["question", "rules", "fieldIndex", "rank", "liveFacts", "response"],
  "nodes": [
    { "id": "question", "lane": "request", "col": 0, "type": "frontend", "label": "商品问题", "sublabel": "保留原始提问", "width": 142 },
    { "id": "rules", "lane": "request", "col": 1, "type": "security", "label": "确定性选域", "sublabel": "型号 / 用途 / 参数", "width": 160 },
    { "id": "jev", "lane": "request", "col": 2, "type": "external", "label": "Jev 多标签提示", "sublabel": "仅在归属不明时", "width": 164 },
    { "id": "fieldIndex", "lane": "catalog", "col": 2, "type": "database", "label": "固定字段索引", "sublabel": "名称 / 用途 / 特征", "width": 160 },
    { "id": "rank", "lane": "catalog", "col": 3, "type": "backend", "label": "分字段排序", "sublabel": "点名商品硬限定", "width": 152 },
    { "id": "baseline", "lane": "catalog", "col": 4, "type": "database", "label": "完整索引兜底", "sublabel": "未点名时软兜底", "width": 154 },
    { "id": "liveFacts", "lane": "result", "col": 4, "type": "backend", "label": "实时目录核实", "sublabel": "价格、库存、硬约束", "width": 158 },
    { "id": "response", "lane": "result", "col": 5, "type": "backend", "label": "有据回复", "sublabel": "Jev 不提供商品事实", "width": 160 }
  ],
  "edges": [
    { "from": "question", "to": "rules" },
    { "from": "rules", "to": "fieldIndex", "label": "明确字段", "variant": "security" },
    { "from": "rules", "to": "jev", "label": "归属不明", "role": "branch", "variant": "dashed" },
    { "from": "jev", "to": "fieldIndex", "label": "高置信字段", "role": "branch", "variant": "dashed" },
    { "from": "fieldIndex", "to": "rank" },
    { "from": "rank", "to": "baseline", "label": "软兜底", "role": "branch", "variant": "dashed" },
    { "from": "rank", "to": "liveFacts", "label": "候选编码", "variant": "emphasis" },
    { "from": "baseline", "to": "liveFacts", "label": "补足召回", "role": "branch", "variant": "dashed" },
    { "from": "liveFacts", "to": "response", "label": "实时事实", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "emerald", "title": "目录字段", "items": ["别名由管理员维护；适用标签有资料来源", "重量、分场景续航和主动降噪保留结构化证据"] },
    { "dot": "cyan", "title": "安全边界", "items": ["Jev 只建议字段；只读事实链逐商品核对覆盖", "未知不造数；字段与回复摘要绑定，便于评估复核"] }
  ]
}
