  "cards": [
    {
      "dot": "cyan",
      "title": "画像可选，情绪与画像并行",
      "items": [
        "Consumer 内独立有界执行；情绪推理预算 750 ms。",
        "商品节点本轮最多等画像 500 ms，超时继续，迟到结果留待后续轮次。"
      ]
    },
    {
      "dot": "violet",
      "title": "排队有优先级，执行不抢占",
      "items": [
        "接入与执行器属于同一服务；每实例默认 4 路消费。",
        "Redis 防重，先记结果再 ACK；不确定业务进入死信核查。"
      ]
    },
    {
      "dot": "emerald",
      "title": "只展示主调用关系",
      "items": [
        "存储和模型为共享依赖，图中省略其他访问边。",
        "General 已移除；Router 内置兜底，Registry / Runtime 提供工具。"
      ]
    }
