  "cards": [
    {
      "dot": "cyan",
      "title": "主请求路径",
      "items": [
        "前端经 Gateway 完成认证接入，Consumer 管理对话、画像和前置缓存",
        "仅经策略认证的单意图缓存命中会跳过 Router；其余请求进入模型路由",
        "Consumer readiness 同时验证 Router 连通性，避免入口健康但编排不可用"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent 与确定性工作流",
      "items": [
        "Product 完成候选查询、三维分析、核实推荐与一次重新分析",
        "Order 由 Agent 补齐参数，写操作在二次确认后交给确定性工作流",
        "分配失败时由 Tool Registry / Runtime 提供通用兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "边界与运行基础设施",
      "items": [
        "Common 仅保留跨服务复用能力，模块专属配置与实现下沉到所属服务",
        "Redis 保存会话、语义缓存和检查点；RabbitMQ 扫描并触发过期工作流恢复",
        "业务咨询随知识版本失效，热门商品缓存使用严格短 TTL"
      ]
    }
  ]
