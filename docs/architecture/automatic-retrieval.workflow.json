{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {"title": "SmartAssistant 有界自动重检索", "locale": "zh-CN", "quality_profile": "showcase"},
  "lanes": [{"id": "online", "label": "在线只读检索"}, {"id": "retry", "label": "证据缺口与安全回退"}, {"id": "offline", "label": "离线验收与校准"}],
  "mainPath": ["question", "first", "check", "second", "compare", "answer"],
  "nodes": [
    {"id": "question", "lane": "online", "col": 0, "type": "frontend", "label": "用户问题", "sublabel": "原问题与服务端权限"},
    {"id": "first", "lane": "online", "col": 1, "type": "backend", "label": "首轮证据", "sublabel": "目录事实优先 · 选域"},
    {"id": "check", "lane": "retry", "col": 1, "type": "security", "label": "只读与缺口检查", "sublabel": "词项覆盖代理 · 非 Ragas"},
    {"id": "second", "lane": "retry", "col": 2, "type": "database", "label": "一次知识库重检索", "sublabel": "同权限同域 · 候选 5→8", "width": 144},
    {"id": "compare", "lane": "retry", "col": 3, "type": "security", "label": "候选安全比较", "sublabel": "同名称补缺 · 保留原文"},
    {"id": "fallback", "lane": "retry", "col": 4, "type": "backend", "label": "保留首轮结果", "sublabel": "超时或无可靠改进"},
    {"id": "answer", "lane": "online", "col": 5, "type": "backend", "label": "回答或明确拒答", "sublabel": "记录实际重试与选用轮次"},
    {"id": "gold", "lane": "offline", "col": 0, "type": "database", "label": "冻结样本与断言", "sublabel": "参考事实 · 负例 · 权限"},
    {"id": "ragas", "lane": "offline", "col": 2, "type": "external", "label": "Ragas 四维评测", "sublabel": "召回 · 精度 · 忠实 · 相关", "width": 144},
    {"id": "release", "lane": "offline", "col": 4, "type": "security", "label": "上线验证门禁", "sublabel": "隔离对照 · 浏览器验收"}
  ],
  "edges": [
    {"from": "question", "to": "first"},
    {"from": "first", "to": "check", "label": "知识类问题"},
    {"from": "first", "to": "answer", "label": "目录事实直接返回", "role": "branch"},
    {"from": "check", "to": "second", "label": "缺口且允许", "role": "main"},
    {"from": "second", "to": "compare"},
    {"from": "compare", "to": "answer", "label": "可靠补足", "role": "main"},
    {"from": "compare", "to": "fallback", "label": "不采用", "role": "error"},
    {"from": "fallback", "to": "answer", "label": "原证据", "role": "return"},
    {"from": "gold", "to": "ragas", "label": "对照样本"},
    {"from": "ragas", "to": "release", "label": "验收报告"}
  ],
  "cards": [
    {"dot": "cyan", "title": "在线边界", "items": ["最多重试一次 · 两个并发席位 · 无排队", "默认额外时限 1500 ms · 不改写实体或全局权重"]},
    {"dot": "rose", "title": "不触发业务写操作", "items": ["下单、支付、退款与资料变更排除", "目录 UNKNOWN 不靠模糊检索填值"]},
    {"dot": "violet", "title": "指标边界", "items": ["在线词项覆盖只是缺口代理", "四维 Ragas 结果不直接驱动无限重试"]}
  ]
}
