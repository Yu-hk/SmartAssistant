    {"id": "initialize", "lane": "model", "col": 1, "type": "backend", "label": "初始化模型", "sublabel": "加载本地 ONNX 会话", "width": 184},
    {"id": "available", "lane": "model", "col": 2, "type": "backend", "label": "模型可用", "sublabel": "HTTP 请求共享模型", "width": 184},
    {"id": "degraded", "lane": "fallback", "col": 2, "type": "external", "label": "初始化失败", "sublabel": "可用状态为 false", "width": 184},
    {"id": "closing", "lane": "spring", "col": 3, "type": "backend", "label": "容器关闭", "sublabel": "触发生命周期销毁", "width": 184},
    {"id": "cleanup", "lane": "model", "col": 4, "type": "backend", "label": "唯一释放入口", "sublabel": "Application.cleanup", "width": 184},
